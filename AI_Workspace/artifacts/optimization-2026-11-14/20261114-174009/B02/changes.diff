+
+uint8_t chassis_data_read(chassis_data_t *out, uint32_t *generation)
+{
+	uint32_t before;
+	uint32_t after;
+	uint32_t attempt;
+	if (out == NULL)
+	{
+		return 0U;
+	}
+	for (attempt = 0U; attempt < 8U; attempt++)
+	{
+		before = chassis_rx_seq;
+		if ((before & 1U) != 0U)
+		{
+			continue;
+		}
+		__DMB();
+		*out = chassis_data;
+		__DMB();
+		after = chassis_rx_seq;
+		if (before == after)
+		{
+			if (generation != NULL)
+			{
+				*generation = before >> 1;
+			}
+			return 1U;
+		}
+	}
+	return 0U;
