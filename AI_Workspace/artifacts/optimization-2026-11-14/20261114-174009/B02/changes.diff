+sys.path.insert(0, str(DEPENDENCIES))
+from elftools.elf.elffile import ELFFile
+from unicorn import Uc, UC_ARCH_ARM, UC_HOOK_CODE, UC_MODE_MCLASS, UC_MODE_THUMB
+from unicorn.arm_const import UC_ARM_REG_SP
